---
/**
 * The quote experience, to the "luxe" mock: a room photo behind a frosted
 * white panel; the wizard in a solid navy card on the left; the glowing
 * "Contact Us Directly" card and a "Why Get a Quote?" checklist on the right;
 * FAQs in a bar underneath.
 *
 * The one quote section on the site — homepage, /contact, the Daikin guide,
 * the service pages, every suburb page and /service-areas all use it, so a
 * quote form looks the same (and stands out the same way) wherever it is.
 * The form comes in through the slot. Every claim on the panel is one the
 * site already makes: 24-hour response, upfront pricing, the 10-year
 * workmanship warranty, Daikin & Haier certification, Mon–Sat 7–6.
 */
import {
  ShieldCheck, Clock3, Star, Phone, Mail, MapPin, Clock, ChevronRight, CheckCircle2, ArrowRight, Plus,
} from 'lucide-react';
import { SITE } from '@/data/site';
import { QUOTE_FAQS } from '@/data/faqs';
// The homepage keeps its own plant-filled room so the hero's photo is not
// shown twice in a row; every other page uses the hero's room, so the quote
// section is recognisably the same one visitors saw on the homepage.
import quoteRoom from '@/assets/hero/quote-room.jpg?url';
import heroRoom from '@/assets/hero/lounge.jpg?url';

interface Props {
  /** h1 on /contact, h2 everywhere else. */
  as?: 'h1' | 'h2';
  /** Section id — "quote", the anchor every "Get a Free Quote" button targets. */
  id?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  /** 'room' = the homepage's plant-filled room; 'hero' = the hero's lounge. */
  backdrop?: 'room' | 'hero';
  /** Off on pages that already carry their own FAQ section. */
  faqs?: boolean;
}
const DEFAULT_HEADING = 'Your Comfort Starts Here';
const {
  as = 'h2',
  id,
  eyebrow = 'Comfort for a brighter tomorrow',
  heading = DEFAULT_HEADING,
  subheading = 'Let’s find the right AC solution for you.',
  backdrop = 'room',
  faqs = true,
} = Astro.props;
const Heading = as;

const chips = [
  { icon: ShieldCheck, label: 'Trusted Local Experts' },
  { icon: Clock3, label: 'Response within 24 hours' },
  { icon: Star, label: '5-Star Rated' },
];
const contact = [
  { icon: Phone, label: 'Call Us', value: SITE.phoneDisplay, href: SITE.phoneTel },
  { icon: Mail, label: 'Email', value: SITE.email, href: `mailto:${SITE.email}` },
  { icon: MapPin, label: 'Service Area', value: 'Sydney-Wide Coverage', href: '/service-areas' },
  { icon: Clock, label: 'Hours', value: SITE.hoursDisplay },
];
const why = [
  'Free, no-obligation assessment',
  'Response within 24 hours',
  'Transparent upfront pricing',
  '10-year workmanship warranty',
  'Daikin & Haier certified installations',
];
---

<section id={id} class="q-scene relative isolate overflow-hidden py-14 sm:py-20 lg:py-24 scroll-mt-24">
  {backdrop === 'room' ? (
    /* Backdrop: a bright, plant-filled living room, softened under a
       page-colour veil — deliberately different from the hero's own render. */
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img src={quoteRoom} alt="" class="h-full w-full scale-105 object-cover object-[50%_45%] blur-[2px] dark:brightness-[0.7]" loading="lazy" decoding="async" />
      {/* Two stacked veils — a flat wash plus a top/bottom-heavy gradient —
          were compounding to whiteout the room's own plants. Both cut ~20
          points so more of the actual photo (the green) shows through. */}
      <div class="absolute inset-0 bg-background/40 dark:bg-background/55"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-background/50 via-transparent to-background/60"></div>
      {/* Feathers the seam with the hero photo above: without this the hero's
          flat veil ends abruptly and this section's own veil starts already
          70% white, reading as a hard cut rather than one scene continuing
          into the next. */}
      <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-background to-transparent sm:h-32 lg:h-40"></div>
    </div>
  ) : (
    /* Backdrop: the hero's own lounge, under the hero's own veil, so the
       quote section reads as the one from the homepage. Feathered top and
       bottom into page colour, since it sits mid-page between sections. */
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img src={heroRoom} alt="" class="h-full w-full object-cover object-[62%_40%]" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-background/15 dark:bg-black/35"></div>
      <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-background to-transparent sm:h-32 lg:h-40"></div>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background to-transparent sm:h-32 lg:h-40"></div>
    </div>
  )}

  {/* Decorative vertical words, right edge, large screens only. */}
  <div class="q-vertical pointer-events-none absolute right-6 top-1/2 hidden -translate-y-1/2 xl:block" aria-hidden="true">
    <span>Install</span><span>Repair</span><span>Maintain</span><span class="q-vertical-sub">For a cooler tomorrow</span>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-10">
    <div class="mb-8 max-w-3xl sm:mb-10">
      <span class="q-eyebrow">{eyebrow}</span>
      {/* The default heading is forced to two lines on mobile ("Your Comfort"
          / "Starts Here") — at text-4xl it read as one small line the width
          of the phone. Page-specific headings wrap naturally. */}
      {heading === DEFAULT_HEADING ? (
        <Heading class="mb-3 text-5xl leading-[1.05] sm:text-5xl sm:leading-tight lg:text-6xl">
          <span class="block sm:inline">Your Comfort</span>{' '}
          <span class="block sm:inline">Starts Here</span>
        </Heading>
      ) : (
        <Heading class="mb-3 text-4xl leading-[1.08] sm:text-5xl sm:leading-tight lg:text-6xl">{heading}</Heading>
      )}
      <p class="mb-5 text-base text-foreground/80 sm:text-lg">{subheading}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {chips.map((c) => (
          <li class="flex items-center gap-2 text-sm font-medium text-foreground/85">
            <c.icon className="h-5 w-5 text-[hsl(var(--q-teal))]" aria-hidden="true" />
            {c.label}
          </li>
        ))}
      </ul>
    </div>

    <div class="q-glass">
      <div class="grid gap-5 lg:grid-cols-[1.25fr_1fr] lg:gap-6">
        {/* The form — compact wizard on the homepage, the full form on /contact.
            Teal, not the plain light card: this is the section's one actual
            call to action, and it should read as the obvious focal point
            next to the informational card beside it. */}
        <div class="q-teal p-5 sm:p-6 lg:p-7">
          <slot />
        </div>

        <div class="flex flex-col gap-5 lg:gap-6">
          {/* Neutral slate, not teal — informational, not the CTA, so it
              recedes rather than competing with the form for attention. */}
          <div class="q-slate q-slate--glow p-5 sm:p-6">
            <div class="mb-4 flex items-baseline justify-between gap-3">
              <h3 class="text-xl font-semibold text-white sm:text-2xl">Contact Us <span class="q-slate-accent">Directly</span></h3>
              <span class="q-kicker text-white/90">We’re here to help</span>
            </div>
            <ul class="space-y-3">
              {contact.map((c) => {
                const Row = c.href ? 'a' : 'div';
                return (
                  <li>
                    <Row href={c.href} class="q-row">
                      <span class="q-row-icon"><c.icon className="h-[18px] w-[18px]" aria-hidden="true" /></span>
                      <span class="min-w-0 flex-1">
                        <span class="q-row-label block text-xs">{c.label}</span>
                        <span class="q-row-value block truncate text-[15px] font-semibold">{c.value}</span>
                      </span>
                      {c.href && <span class="q-row-chevron"><ChevronRight className="h-4 w-4" aria-hidden="true" /></span>}
                    </Row>
                  </li>
                );
              })}
            </ul>
          </div>

          <div class="q-why relative overflow-hidden p-5 sm:p-6">
            <div class="mb-4 flex items-baseline justify-between gap-3">
              <h3 class="text-xl font-semibold sm:text-2xl">Why Get a Quote?</h3>
              <span class="q-kicker text-foreground/55">Quality you can count on</span>
            </div>
            <ul class="relative z-10 space-y-2.5">
              {why.map((w) => (
                <li class="flex items-center gap-3 text-sm sm:text-[15px]">
                  <CheckCircle2 className="h-5 w-5 shrink-0 text-[hsl(var(--q-teal))]" aria-hidden="true" />
                  {w}
                </li>
              ))}
            </ul>
            {/* concentric arcs + badge, bottom-right */}
            <svg class="pointer-events-none absolute -bottom-24 -right-16 h-72 w-72 text-[hsl(var(--q-teal))] opacity-[0.18]" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <circle cx="100" cy="100" r="96" /><circle cx="100" cy="100" r="80" /><circle cx="100" cy="100" r="64" /><circle cx="100" cy="100" r="48" /><circle cx="100" cy="100" r="32" />
            </svg>
            <div class="absolute bottom-5 right-5 hidden flex-col items-center text-center sm:flex" aria-hidden="true">
              <ShieldCheck className="mb-1 h-7 w-7 text-[hsl(var(--q-teal))]" />
              <span class="q-kicker text-foreground/60">Comfort</span>
              <span class="text-[9px] uppercase tracking-[0.22em] text-foreground/45">Peace of mind built in</span>
            </div>
          </div>
        </div>
      </div>

      {/* FAQs */}
      {faqs && (
      <div class="q-faq mt-5 lg:mt-6">
        <div class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-3">
          <h3 class="text-2xl font-semibold">FAQs</h3>
          <p class="text-sm text-foreground/70">Quick answers to common questions.</p>
          <div class="ml-auto flex items-center gap-4">
            <span class="q-kicker hidden text-foreground/55 sm:inline">Still have a question?</span>
            <a href={SITE.phoneTel} class="q-btn">Get in Touch <ArrowRight className="h-4 w-4" aria-hidden="true" /></a>
          </div>
        </div>
        <div class="space-y-2">
          {QUOTE_FAQS.map((f) => (
            <details class="q-faq-item">
              <summary>
                <span class="q-faq-q">{f.q}</span>
                <span class="q-faq-a">{f.a}</span>
                <span class="q-faq-plus" aria-hidden="true"><Plus className="h-4 w-4" /></span>
              </summary>
              <p class="q-faq-full">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
      )}
    </div>

    <p class="q-tagline">Cooler spaces · Brighter lives</p>
  </div>
</section>
