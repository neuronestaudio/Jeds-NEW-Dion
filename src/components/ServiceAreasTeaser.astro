---
import { SUBURBS, ZONES } from '@/data/suburbs';

const north = SUBURBS.filter((s) => s.zone === 'north');
const east = SUBURBS.filter((s) => s.zone === 'east');
---

<section class="py-12 sm:py-16 md:py-20 border-t border-border/30 bg-card/20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold mb-2">Areas We Service</h2>
        <p class="text-muted-foreground text-sm sm:text-base max-w-2xl">
          Local air conditioning installs, servicing and repairs across Sydney’s North Shore and Eastern Suburbs.
        </p>
      </div>
      <a href="/service-areas" class="inline-flex items-center gap-2 text-primary font-medium hover:underline">
        All service areas →
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="glass-card p-5 sm:p-6">
        <h3 class="font-semibold mb-3">
          <a href={`/service-areas#${ZONES.north.id}`} class="hover:text-primary transition-colors">{ZONES.north.label}</a>
        </h3>
        <ul class="flex flex-wrap gap-2">
          {north.map((s) => (
            <li>
              <a
                href={`/service-area/${s.slug}`}
                class="inline-block rounded-full border border-border/40 bg-card/60 px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground"
              >
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="glass-card p-5 sm:p-6">
        <h3 class="font-semibold mb-3">
          <a href={`/service-areas#${ZONES.east.id}`} class="hover:text-primary transition-colors">{ZONES.east.label}</a>
        </h3>
        <ul class="flex flex-wrap gap-2">
          {east.map((s) => (
            <li>
              <a
                href={`/service-area/${s.slug}`}
                class="inline-block rounded-full border border-border/40 bg-card/60 px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground"
              >
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
