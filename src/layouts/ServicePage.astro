---
import Base from '@/layouts/Base.astro';
import QuoteForm from '@/components/QuoteForm';
import ServiceAreasTeaser from '@/components/ServiceAreasTeaser.astro';
import { BUSINESS_ID, breadcrumbJsonLd, faqJsonLd } from '@/data/site';

interface Props {
  path: string;
  title: string;
  description: string;
  serviceType: string;
  breadcrumb: string;
  heading: string;
  intro: string;
  pointsHeading: string;
  points: string[];
  faqs: { q: string; a: string }[];
  quoteHeading: string;
}

const { path, title, description, serviceType, breadcrumb, heading, intro, pointsHeading, points, faqs, quoteHeading } =
  Astro.props;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType,
  provider: { '@id': BUSINESS_ID },
  areaServed: { '@type': 'City', name: 'Sydney' },
};
---

<Base
  title={title}
  description={description}
  path={path}
  jsonLd={[
    serviceLd,
    breadcrumbJsonLd([
      { name: 'Services', path: '/services' },
      { name: breadcrumb, path },
    ]),
    faqJsonLd(faqs),
  ]}
>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <span class="eyebrow">{breadcrumb}</span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">{heading}</h1>
      <p class="text-muted-foreground text-lg max-w-3xl mb-10">{intro}</p>
      <div class="glass-card p-6 md:p-8 mb-10">
        <h2 class="text-2xl font-semibold mb-4">{pointsHeading}</h2>
        <ul class="list-disc pl-5 space-y-2 text-muted-foreground">
          {points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="glass-card p-6 md:p-8 mb-10">
        <h2 class="text-2xl font-semibold mb-4">FAQs</h2>
        <div class="space-y-4 text-muted-foreground">
          {
            faqs.map((f) => (
              <div>
                <h3 class="font-semibold">{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="glass-card p-6 md:p-8">
        <h2 class="text-2xl font-semibold mb-4">{quoteHeading}</h2>
        <QuoteForm client:visible />
      </div>
    </div>
  </section>
  <ServiceAreasTeaser />
</Base>
