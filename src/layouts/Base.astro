---
import '@/index.css';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import { Toaster } from '@/components/ui/toaster';
import { SITE, businessJsonLd } from '@/data/site';
// Splash backdrop: the hero's own room render, at 50% opacity, so the
// splash is brand-consistent rather than an unrelated texture. The build-on
// clip is re-cropped full width (1280 of 1280px — no horizontal crop at
// all) and generously tall (520 of 720px): the earlier crop, tight around
// the settled mark, clipped the gear's own motion streaks as it spun in.
// This one has clear margin on every side.
import splashBg from '@/assets/hero/lounge.jpg?url';
import splashStill from '@/assets/hero/splash-lockup-still.png?url';

interface Props {
  title: string;
  description: string;
  /** Route path, e.g. "/service-area/bondi". Canonical is always the apex domain + this. */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Extra JSON-LD blocks for this page; the business entity is always included. */
  jsonLd?: unknown[];
  noindex?: boolean;
}

const { title, description, path, ogTitle, ogDescription, jsonLd = [], noindex = false } = Astro.props;
const canonical = `${SITE.url}${path === '/' ? '/' : path}`;
const ogImage = `${SITE.url}${SITE.ogImage}`;
const blocks = [businessJsonLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Theme before first paint: light unless this visitor chose dark. Inline
      // and first in <head> so there is never a flash of the other palette.
      (function () {
        try {
          var dark = localStorage.getItem('jed-theme') === 'dark';
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />


    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=2" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jedaircon" />
    <meta name="twitter:image" content={ogImage} />

    {blocks.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />)}
    <slot name="head" />
  </head>
  <body>
    <!--
      Entrance splash: carbon-mesh + brushed-metal backdrop, the header's own
      logo fading and scaling up to rest at 50% opacity over it. Shows once
      per browser session (not once per page — sessionStorage, not per-route)
      and only when motion is not reduced. Plain HTML/CSS/JS rather than a
      hydrated island: it has to exist and be dismissable before React ever
      hydrates, the same reason the theme switch above is an inline script.
    -->
    <div id="jed-splash" aria-hidden="true">
      <div class="jed-splash__bg">
        <img src={splashBg} alt="" decoding="async" />
      </div>
      <div class="jed-splash__stripe jed-splash__stripe--tl"></div>
      <div class="jed-splash__stripe jed-splash__stripe--br"></div>
      <div class="jed-splash__mark">
        <img id="jed-splash-still" src={splashStill} alt="" decoding="async" />
        <video id="jed-splash-video" src="/splash-lockup.mp4" muted playsinline preload="auto" tabindex="-1"></video>
      </div>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'jed-splash-shown';
        var el = document.getElementById('jed-splash');
        if (!el) return;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var shown;
        try {
          shown = sessionStorage.getItem(KEY);
        } catch (e) {
          shown = null; // private mode etc. — fail open, just don't persist
        }
        if (shown || reduce) {
          el.remove();
          return;
        }
        try {
          sessionStorage.setItem(KEY, '1');
        } catch (e) {}

        var video = document.getElementById('jed-splash-video');
        var still = document.getElementById('jed-splash-still');
        var done = false;
        function dismiss() {
          if (done) return;
          done = true;
          el.classList.add('is-leaving');
          window.setTimeout(function () {
            el.remove();
          }, 450);
        }
        video.addEventListener('playing', function () {
          still.style.opacity = '0';
          video.style.opacity = '1';
        });
        // A touch of hold after the build finishes so the finished mark
        // registers before the whole screen fades, without turning this
        // into a long wait.
        video.addEventListener('ended', function () {
          window.setTimeout(dismiss, 400);
        });
        video.addEventListener('error', dismiss);
        video.muted = true;
        video.play().catch(dismiss);

        // Always escapable: a click, a key, or a hard cap if anything hangs.
        el.addEventListener('click', dismiss);
        window.addEventListener('keydown', dismiss, { once: true });
        window.setTimeout(dismiss, 3400);
      })();
    </script>

    <Header client:load />
    <main id="main-content" role="main" tabindex="-1" class="min-h-screen pb-24 lg:pb-0">
      <slot />
    </main>
    <Footer />
    <Toaster client:idle />

    <script>
      import { initAnalytics } from '@/lib/analytics';
      import { captureAttribution } from '@/lib/attribution';
      initAnalytics();
      // Runs on every page so the FIRST page a visitor lands on is the one
      // recorded against them, campaign and click id included, however many
      // pages later they enquire.
      captureAttribution();
    </script>
    <!-- The GHL chat widget (LeadConnector, widget 699c4853247354e9d8535b39) was
         removed 13 Sep 2026 — it sat over the hero trust bar and the phone CTA
         bar and read as tacky. To bring it back, revert the commit that removed
         it: the loader tag and src/lib/chat-widget-offset.ts come back together. -->
  </body>
</html>
