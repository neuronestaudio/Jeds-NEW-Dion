---
import Base from '@/layouts/Base.astro';
import CtaRow from '@/components/CtaRow';
---

<Base
  title="Thank You | JED Air Conditioning"
  description="Thanks for your quote request. A member of our team will contact you within 1 business day."
  path="/thank-you"
  noindex
>
  <section class="py-20 md:py-28">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl rounded-2xl border border-border/60 bg-card/40 p-8 md:p-12 text-center">
        <h1 class="text-3xl md:text-5xl font-bold mb-4">Thank You</h1>
        <p class="text-lg text-muted-foreground mb-8">
          Your quote request has been received. We will contact you within 1 business day.
        </p>
        <CtaRow quoteHref="/" quoteLabel="Back to Home" location="thank-you" align="center" />
      </div>
    </div>
  </section>
</Base>
