---
import Base from '@/layouts/Base.astro';
import QuoteForm from '@/components/QuoteForm';
import { faqJsonLd } from '@/data/site';

const faqs = [
  {
    q: 'How soon will you contact me back?',
    a: 'We typically respond the same business day, and for urgent repairs we aim to call within a few hours.',
  },
  {
    q: 'What information helps speed up a quote?',
    a: 'Room size, property type, existing AC (if any), and any brand preferences help us provide an accurate quote faster.',
  },
  {
    q: 'Do you service all of Sydney?',
    a: 'Yes, we provide Sydney-wide service, with a focus on the North Shore and Eastern Suburbs. Share your suburb and we will confirm availability.',
  },
];
---

<Base
  title="Get a Free Air Conditioning Quote | Sydney"
  description="Request a free quote for air conditioning installation, repairs, or maintenance in Sydney."
  path="/contact"
  jsonLd={[faqJsonLd(faqs)]}
>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">Get a Free Quote</h1>
      <p class="text-muted-foreground text-lg max-w-2xl mb-10">Tell us about your AC needs and we’ll respond promptly.</p>
      {/* QuoteForm carries its own id="quote" for the header/mobile-bar CTAs. */}
      <div class="glass-card p-6 md:p-8">
        <QuoteForm client:visible />
      </div>
      <div class="glass-card p-6 md:p-8 mt-10">
        <h2 class="text-2xl font-semibold mb-4">FAQs</h2>
        <div class="space-y-4 text-muted-foreground">
          {
            faqs.map((f) => (
              <div>
                <h3 class="font-semibold">{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>
