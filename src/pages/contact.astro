---
import Base from '@/layouts/Base.astro';
import QuotePanel from '@/components/QuotePanel.astro';
import QuoteWizard from '@/components/QuoteWizard';
import { faqJsonLd } from '@/data/site';
import { QUOTE_FAQS } from '@/data/faqs';
---

<Base
  title="Get a Free Air Conditioning Quote | Sydney"
  description="Request a free quote for air conditioning installation, repairs, or maintenance in Sydney."
  path="/contact"
  jsonLd={[faqJsonLd(QUOTE_FAQS)]}
>
  {/* The bare wizard, not QuoteForm: QuoteForm brings its own contact aside,
      which the panel already provides — /contact was showing it twice. The
      section carries the #quote the header and mobile-bar CTAs target, and the
      GHL `source` stays "bottom-quote" so existing workflows keep matching. */}
  <QuotePanel as="h1" id="quote">
    <QuoteWizard
      client:visible
      source="bottom-quote"
      heading="Get a Free Quote"
      subheading="Two quick taps, then your details — we’ll come back to you within 24 hours with a detailed quote."
    />
  </QuotePanel>
</Base>
