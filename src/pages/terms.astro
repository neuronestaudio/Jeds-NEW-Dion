---
import Base from '@/layouts/Base.astro';
import { SITE } from '@/data/site';
---

<Base title="Terms of Service | JED Air Conditioning" description="Terms of service for JED Air Conditioning." path="/terms">
  <section class="container mx-auto px-4 sm:px-6 lg:px-10 py-16 md:py-24">
    <h1 class="text-3xl md:text-4xl font-bold mb-6">Terms of Service</h1>
    <p class="text-muted-foreground mb-4">
      These terms outline the use of services provided by JED Air Conditioning.
    </p>
    <p class="text-muted-foreground">
      For questions about these terms, contact us at <a href={`mailto:${SITE.email}`} class="text-primary hover:underline">{SITE.email}</a>.
    </p>
  </section>
</Base>
