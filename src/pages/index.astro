---
import Base from '@/layouts/Base.astro';
import HeroSection from '@/components/HeroSection';
import QuoteSection from '@/components/QuoteSection.astro';
import BrandsSection from '@/components/BrandsSection';
import ReviewsSection from '@/components/ReviewsSection';
import TrustBar from '@/components/TrustBar';
import ServicesCoverflow from '@/components/ServicesCoverflow';
import ProjectsGallery from '@/components/ProjectsGallery';
import SocialReels from '@/components/SocialReels';
import WhyChooseUs from '@/components/WhyChooseUs';
import ProcessSection from '@/components/ProcessSection';
import ServiceAreasTeaser from '@/components/ServiceAreasTeaser.astro';
---

<Base
  title="Daikin & Haier Air Conditioning Installation Sydney | JED Air Conditioning"
  description="Authorised Daikin & Haier installation specialists across Sydney's North Shore and Eastern Suburbs. Professional ducted & split system air conditioning installs, service & repairs. Get a free quote now."
  path="/"
  ogTitle="JED Air Conditioning | Sydney Air Conditioning Specialists"
  ogDescription="Daikin certified dealer. Professional installation, repairs & maintenance. 10-year workmanship warranty."
>
  <HeroSection client:load />
  <QuoteSection />
  <BrandsSection client:visible />
  {/* Was two overlapping "what we offer" sections — the plain diagonal-panel
      "How Can We Help?" (ServicePathways) and this carousel. The carousel is
      the more complete, more recently built version, so it now stands alone
      in the earlier slot the other one held. ServicePathways.tsx is unused
      but left intact, not deleted. */}
  <ServicesCoverflow client:visible />
  <SocialReels client:visible />
  <ReviewsSection client:visible />
  <div class="brick"><TrustBar client:visible /></div>
  <ProjectsGallery client:visible />
  {/* One wrapper, not three: the brick is background-attachment: fixed, so a
      single wall behind all three reads as continuous with no seams. */}
  <div class="brick">
    <WhyChooseUs client:visible />
    <ProcessSection client:visible />
    <ServiceAreasTeaser />
  </div>
</Base>
